# Keep the real values in an untracked .env file or the hosting environment.
# ChatGPT subscriptions and OpenAI API billing are separate.
OPENAI_API_KEY=

# Required in production, at least 16 characters. This is the personal coaching
# access code entered in the website, not the OpenAI key. Use a random value.
APP_ACCESS_CODE=

# Exact allowed browser origins, comma separated. Local same-origin and the
# Render HTTPS origin from RENDER_EXTERNAL_URL are included automatically.
# For a custom domain or another Node host behind an HTTPS reverse proxy,
# add that server's own public HTTPS origin here. No paths or trailing slashes.
# Only add origins you control.
ALLOWED_ORIGINS=https://sirawatsp.github.io

# Verified against OpenAI's model docs on 2026-11-14; override if your project
# needs a different supported model. Never expose these values as client input.
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Local server defaults to loopback. Set NODE_ENV=production on hosted servers.
PORT=8000
HOST=127.0.0.1
